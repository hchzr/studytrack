// ─────────────────────────────────────────────────────────────────────────────
//  Configuration Supabase — édite CE FICHIER.
//
//  Ces deux valeurs sont compilées dans l'app (lues par `SupabaseConfig`) et ne
//  sont JAMAIS demandées à l'utilisateur.
//
//  Où les trouver : dans Supabase ▸ Project Settings ▸ API
//     « Project URL »      → le domaine, à recopier dans SUPABASE_HOST
//     « anon public » key  → la longue chaîne, dans SUPABASE_ANON_KEY
//
//  ⚠️  SUPABASE_HOST se met SANS « https:// ».
//      Un fichier .xcconfig considère « // » comme le début d'un commentaire :
//      écrire « https://xyz.supabase.co » ici ne garderait que « https: ».
//      L'app ajoute le schéma elle-même.
//
//  Exemple :
//     SUPABASE_HOST = abcdefghijklmnop.supabase.co
//     SUPABASE_ANON_KEY = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
//
//  Les laisser vides est un état VALIDE : l'app se lance, le suivi des cours, le
//  temps de travail, l'agenda et les widgets fonctionnent normalement. Seuls les
//  groupes sont indisponibles, et l'écran Compte l'annonce explicitement.
// ─────────────────────────────────────────────────────────────────────────────

SUPABASE_HOST = aaigscutkuefhqftfszv.supabase.co
SUPABASE_ANON_KEY = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImFhaWdzY3V0a3VlZmhxZnRmc3p2Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODk0OTQyNzksImV4cCI6MjEwNTA3MDI3OX0.xP4wQW_oJhOFdko5F4l-SP1L1iTK8z5pSPh1Ur1ul3c

// ─────────────────────────────────────────────────────────────────────────────
//  OAuth des fournisseurs de tâches — identifiants CLIENT (publics).
//  Vide = le bouton « Se connecter avec… » n'apparaît pas pour ce fournisseur.
//  Les SECRETS ne vont jamais ici : `supabase secrets set` (voir SUPABASE.md).
//  Google : l'identifiant d'un client « iOS » (sans secret).
// ─────────────────────────────────────────────────────────────────────────────
TODOIST_CLIENT_ID = 5ab65c1fe96e4e66b94900ca202fbeb6
GOOGLE_CLIENT_ID = 413798671134-b7iho9eeluot8a9godf8uujb69kuj24h.apps.googleusercontent.com
TICKTICK_CLIENT_ID = eu29Eh8ZryZku9GC1M
NOTION_CLIENT_ID = 3edd872b-594c-819b-9d74-00375522ef0c

// ─────────────────────────────────────────────────────────────────────────────
//  Relais du chrono partagé (Cloudflare Worker, dossier relay/), sans « https:// ».
//  Vide = pas de voie instantanée : le chrono passe alors par iCloud seul.
// ─────────────────────────────────────────────────────────────────────────────
TIMER_RELAY_HOST = relay.polymestre.ch

// ─────────────────────────────────────────────────────────────────────────────
//  Distribution : le courriel de « Signaler un problème » et le site public de
//  l'app (confidentialité, téléchargement du Mac, `mac/latest.json`), sans
//  « https:// ». Vides = pas de bouton, pas de recherche de mise à jour.
// ─────────────────────────────────────────────────────────────────────────────
FEEDBACK_EMAIL = contact@polymestre.ch
SITE_HOST = polymestre.ch

// ─────────────────────────────────────────────────────────────────────────────
//  Temps d'écran (blocage de l'iPhone pendant le mode étude, FamilyControls).
//  Une build distribuée (TestFlight, App Store) ne peut porter ce droit qu'avec
//  l'accord d'Apple : « Family Controls (Distribution) », demandé pour
//  ch.polymestre.app et ch.polymestre.app.lock. Sans lui, l'export
//  échoue. NO : ni le droit (app et extension PolymestreLock, qui reste dans
//  l'app mais n'est jamais lancée), ni le code ni l'interface du blocage sur
//  l'iPhone (le Mac bloque toujours). Accordé le 27 octobre 2026 : YES partout ;
//  NO reste possible pour une build sans Temps d'écran.
// ─────────────────────────────────────────────────────────────────────────────
POLYMESTRE_SCREEN_TIME = YES
POLYMESTRE_SCREEN_TIME_CONDITION_YES = SCREEN_TIME
POLYMESTRE_SCREEN_TIME_CONDITION_NO =
SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited) $(POLYMESTRE_SCREEN_TIME_CONDITION_$(POLYMESTRE_SCREEN_TIME))
POLYMESTRE_APP_ENTITLEMENTS_YES = Support/Polymestre.entitlements
POLYMESTRE_APP_ENTITLEMENTS_NO = Support/Polymestre-NoScreenTime.entitlements
POLYMESTRE_APP_ENTITLEMENTS = $(POLYMESTRE_APP_ENTITLEMENTS_$(POLYMESTRE_SCREEN_TIME))
POLYMESTRE_LOCK_ENTITLEMENTS_YES = Support/PolymestreLock.entitlements
POLYMESTRE_LOCK_ENTITLEMENTS_NO = Support/PolymestreLock-NoScreenTime.entitlements
POLYMESTRE_LOCK_ENTITLEMENTS = $(POLYMESTRE_LOCK_ENTITLEMENTS_$(POLYMESTRE_SCREEN_TIME))
