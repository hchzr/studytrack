<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.hczr.studytrack.moodle-watch</string>
	</array>
	<key>CFBundleDevelopmentRegion</key>
	<string>fr</string>
	<key>CFBundleDisplayName</key>
	<string>StudyTrack</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>studytrack</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>GoogleClientID</key>
	<string>$(GOOGLE_CLIENT_ID)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSAppleMusicUsageDescription</key>
	<string>StudyTrack cherche dans Apple Music et votre bibliothèque pour faire jouer votre musique pendant le mode étude.</string>
	<key>NSCameraUsageDescription</key>
	<string>StudyTrack numérise ta copie pour l'envoyer à ton bureau du Mac (et à Claude), pendant une session.</string>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>StudyTrack utilise votre calendrier pour afficher vos cours, vos midterms et vos sessions d'étude, et pour y ajouter vos sessions planifiées.</string>
	<key>NSCalendarsUsageDescription</key>
	<string>StudyTrack utilise votre calendrier pour afficher vos cours, vos midterms et vos sessions d'étude.</string>
	<key>NSCalendarsWriteOnlyAccessUsageDescription</key>
	<string>StudyTrack ajoute vos sessions d'étude planifiées à votre calendrier.</string>
	<key>NSRemindersFullAccessUsageDescription</key>
	<string>StudyTrack synchronise vos tâches avec l'app Rappels.</string>
	<key>NSRemindersUsageDescription</key>
	<string>StudyTrack synchronise vos tâches avec l'app Rappels.</string>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>NotionClientID</key>
	<string>$(NOTION_CLIENT_ID)</string>
	<key>StudyTrackAppGroup</key>
	<string>$(STUDYTRACK_APP_GROUP)</string>
	<key>SupabaseAnonKey</key>
	<string>$(SUPABASE_ANON_KEY)</string>
	<key>TimerRelayHost</key>
	<string>$(TIMER_RELAY_HOST)</string>
	<key>SupabaseHost</key>
	<string>$(SUPABASE_HOST)</string>
	<key>TickTickClientID</key>
	<string>$(TICKTICK_CLIENT_ID)</string>
	<key>TodoistClientID</key>
	<string>$(TODOIST_CLIENT_ID)</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UIApplicationShortcutItems</key>
	<array>
		<dict>
			<key>UIApplicationShortcutItemIconType</key>
			<string>UIApplicationShortcutIconTypeAdd</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>Importer une série</string>
			<key>UIApplicationShortcutItemType</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER).importSeries</string>
		</dict>
		<dict>
			<key>UIApplicationShortcutItemIconType</key>
			<string>UIApplicationShortcutIconTypePlay</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>Lancer le chrono</string>
			<key>UIApplicationShortcutItemType</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER).startTimer</string>
		</dict>
	</array>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
		<string>remote-notification</string>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
