# La configuration Supabase de ce build — copie ce fichier en « .env » (ignoré
# par git, voir .gitignore) puis relance « npm run build ».
#
# Les valeurs réelles déployables sont celles de Support/Supabase.xcconfig, à la
# racine du dépôt (projet Supabase ▸ Project Settings ▸ API : « Project URL » et
# la clé « anon public »). La clé anon est publique par conception ; la clé
# service_role, elle, ne doit jamais arriver ici.

VITE_SUPABASE_URL=https://ton-projet.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ…la-clé-anon-du-projet…

# L'hôte du relais (sans « https:// », voir relay/ et Support/Supabase.xcconfig :
# TIMER_RELAY_HOST) : l'appairage d'un nouvel appareil à la synchronisation chiffrée
# y passe. Sans lui, seule la clé de secours permet d'ajouter un appareil.
VITE_RELAY_HOST=studytrack-relay.apnsprobe.workers.dev

# Spotify Connect : l'identifiant de l'app créée sur developer.spotify.com (Redirect URI :
# http://127.0.0.1:43827/auth-callback). Public : aucun secret avec PKCE.
VITE_SPOTIFY_CLIENT_ID=
