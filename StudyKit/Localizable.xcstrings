        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Structure: { \"courses\": [ { \"code\": …, \"videos\": […], \"series\": […] } ] }. A StudyTrack backup (Settings › Data and backup) is restored here, progress and sessions included, without duplicates."
          }
        }
      }
    },
